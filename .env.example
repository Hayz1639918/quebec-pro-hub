# ========================================
# BâtirNet - Environment Variables Template
# ========================================
# Copy this file to .env and fill with your actual values
# NEVER commit .env to version control!

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Development Server (Optional)
# VITE_DEV_ORIGIN=http://localhost:5173

# Node Environment (Optional)
# NODE_ENV=development

# ========================================
# Security Notes:
# - The VITE_SUPABASE_PUBLISHABLE_KEY is safe to expose client-side
# - NEVER put SUPABASE_SERVICE_ROLE_KEY here (server-side only!)
# - All variables prefixed with VITE_ are bundled into the frontend
# ========================================
